{
    // Difficulty:
    //   0: No healing
    //   1: Init hp 500 with no healing
    //   2: +25hp for each kill
    //   3: Reheal to 100hp after a kill
    //   4: +100hp for each kill
    //   5: +500hp for each kill
    "Difficulty": 3,
    // Training Mode:
    //   0: Random mode, randomly spawn some targets.
    //   1: Full mode, all targets.
    "TrainingMode": 0,
    // Bot Weapon:
    //   0: Bots buy weapons randomly.
    //   1: Bots use UMP45.
    //   2: Bots use AK47.
    //   3: Bots use Scout.
    //   4: Bots use AWP.
    //   5: Bots use Pistols.
    //   6: Bots use Eco weapons.
    //   7: Bots use Force-buy weapons.
    "BotWeapon": 0,
    // Player Weapon:
    //   ak, m4, m4a1s, awp, deagle, usp, glock, none.
    "PlayerGun": "ak",
    // Bot spawn offset in units (0-64).
    "Jitter": 0,
    // Headshot-only: 1 = body shots do no damage to bots. 0 = off.
    "HeadshotOnly": 0,
    // X-ray: 1 = bots are outlined through walls (only for you). 0 = off.
    "Xray": 0,
    // Menu type:
    //   0: Chat menus (type !1-!9 to choose).
    //   1: Screen menus drawn in the centre of the screen. W/S move, D selects, A goes back, Tab closes.
    //      Arrow keys, Enter and Backspace work after a one-time bind: type !prefire binds.
    "MenuType": 1,
    // Rows of a screen menu shown at once (1-8). Longer menus scroll.
    "MenuRows": 7,
    // Aim lock for bots:
    //   0: CS2's native bot behavior. It works in a consistant manner but is less powerful.
    //   1: CSS based aim lock: Bots always aim at players' heads. But this may conflict with CS2's native bot logic, causing bots to not react under certain circumstances.
    //   2: Behavior tree based aim lock: Hard mode.
    "BotAimLock": 2,
    // EquipPlayer:
    //   0: Disabled. To avoid interfering with other weapon related plugins
    //   1: Enabled. Players will be equipped with AK47, deagle and nades every time they respawn.
    //   2: Behavior tree based aim lock: Hard mode.
    "EquipPlayer": 1
}
